# CDC v4 Lot 2.2 : optionnelle — générée automatiquement au premier démarrage si absente et
# affichée une seule fois dans les logs. À ne renseigner que pour la fournir explicitement.
ENCRYPTION_KEY=

# CDC v4, Lot 3.1 : mot de passe du rôle Postgres applicatif (créé automatiquement par le service
# `db` de compose.yaml). À changer pour un déploiement réel — cette valeur n'est qu'un défaut de
# développement local.
POSTGRES_APP_PASSWORD=achirah_dev_local_only

APP_PORT=3000
COOKIE_SECURE=false
BUDGET_TOKENS_JOUR=2000000
