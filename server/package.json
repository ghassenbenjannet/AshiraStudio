{
  "name": "@achirah/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "db:generate": "drizzle-kit generate",
    "db:provision-role": "tsx src/db/provision-role.ts",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:rls": "tsx src/db/apply-rls.ts",
    "db:seed": "tsx src/db/seed.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@achirah/shared": "*",
    "@ai-sdk/anthropic": "^4.0.41",
    "@ai-sdk/google": "^4.0.50",
    "@ai-sdk/mistral": "^4.0.32",
    "@ai-sdk/openai": "^4.0.46",
    "@aws-sdk/client-s3": "^3.1117.0",
    "@hono/node-server": "^1.13.7",
    "@hono/zod-validator": "^0.4.1",
    "ai": "^7.0.78",
    "bcryptjs": "^2.4.3",
    "drizzle-orm": "^0.36.4",
    "hono": "^4.6.11",
    "nodemailer": "^9.0.5",
    "pdfkit": "^0.15.1",
    "pino": "^9.5.0",
    "postgres": "^3.4.9",
    "web-push": "^3.6.7",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.9.1",
    "@types/nodemailer": "^8.0.1",
    "@types/pdfkit": "^0.13.6",
    "@types/web-push": "^3.6.4",
    "drizzle-kit": "^0.28.1",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.5"
  }
}
