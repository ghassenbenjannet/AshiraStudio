{
  "name": "achirah-hq",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "shared",
    "server",
    "front"
  ],
  "scripts": {
    "dev:server": "npm run dev --workspace=server",
    "dev:front": "npm run dev --workspace=front",
    "build:shared": "npm run build --workspace=shared",
    "build:front": "npm run build --workspace=front",
    "build:server": "npm run build --workspace=server",
    "build": "npm run build:shared && npm run build:front && npm run build:server",
    "db:generate": "npm run db:generate --workspace=server",
    "db:migrate": "npm run db:migrate --workspace=server",
    "db:seed": "npm run db:seed --workspace=server",
    "test": "npm run test --workspace=server && npm run test --workspace=front",
    "typecheck": "npm run typecheck --workspace=shared && npm run typecheck --workspace=server && npm run typecheck --workspace=front",
    "lint": "eslint ."
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "drizzle-orm": "^0.36.4",
    "typescript": "^5.6.3"
  }
}
