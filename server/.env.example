# Copier en .env et remplir. Jamais commité (voir .gitignore).
NODE_ENV=development
PORT=3000
COOKIE_SECURE=false
DATABASE_PATH=./data/achirah.sqlite
UPLOADS_DIR=./uploads
BACKUPS_DIR=./backups

# CDC v4 Lot 2.2 : optionnelle — générée automatiquement au premier démarrage si absente
# (server/data/encryption.key, permissions 600) et affichée une seule fois dans les logs.
# Ne la renseigner ici que pour un déploiement automatisé qui préfère la fournir explicitement.
ENCRYPTION_KEY=

# Tous les autres réglages (IA, emails, push, intégrations, stockage, supervision, sauvegardes) se
# configurent désormais dans l'interface — Paramètres → Configuration — pas dans ce fichier.
BUDGET_TOKENS_JOUR=2000000
