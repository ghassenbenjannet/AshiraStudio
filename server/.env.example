# Copier en .env et remplir. Jamais commité (voir .gitignore).
NODE_ENV=development
PORT=3000
COOKIE_SECURE=false
DATABASE_PATH=./data/achirah.sqlite
UPLOADS_DIR=./uploads
BACKUPS_DIR=./backups

# Clé de chiffrement AES-256 des credentials d'intégrations (§8.3) — 32 octets, jamais côté client.
ENCRYPTION_KEY=

BUDGET_TOKENS_JOUR=2000000
