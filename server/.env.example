# Copier en .env et remplir. Jamais commité (voir .gitignore).
NODE_ENV=development
PORT=3000
COOKIE_SECURE=false

# CDC v4, Lot 3.1 : PostgreSQL local. Connexion applicative sous le rôle dédié `achirah_app`
# (jamais le propriétaire des tables ni un superutilisateur — la RLS du Lot 3.3 en dépend).
# Voir README « Base de données » pour la création du rôle/de la base en local.
DATABASE_URL=postgres://achirah_app:achirah_dev_local_only@127.0.0.1:5432/achirah

# Connexion admin — DDL uniquement (migrations, politiques RLS, sauvegardes). Jamais utilisée par
# le serveur en fonctionnement, seulement par `npm run db:migrate`/`db:rls` et par `pg_dump`.
DATABASE_URL_ADMIN=postgres://postgres:postgres_dev_local_only@127.0.0.1:5432/achirah

UPLOADS_DIR=./uploads
BACKUPS_DIR=./backups

# CDC v4 Lot 2.2 : optionnelle — générée automatiquement au premier démarrage si absente
# (server/data/encryption.key, permissions 600) et affichée une seule fois dans les logs.
# Ne la renseigner ici que pour un déploiement automatisé qui préfère la fournir explicitement.
ENCRYPTION_KEY=

# Tous les autres réglages (IA, emails, push, intégrations, stockage, supervision, sauvegardes) se
# configurent désormais dans l'interface — Paramètres → Configuration — pas dans ce fichier.
BUDGET_TOKENS_JOUR=2000000
